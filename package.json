{
  "name": "codebuddy-gui",
  "version": "1.1.2",
  "description": "Multi-project desktop client for CodeBuddy CLI (CodeBuddy Desktop)",
  "author": "ChisaAlter",
  "copyright": "Copyright 2026 ChisaAlter",
  "homepage": "https://github.com/ChisaAlter/codebuddy-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChisaAlter/codebuddy-desktop.git"
  },
  "main": "electron/main.cjs",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/mobile-remote-protocol",
    "packages/mobile-remote-crypto",
    "packages/mobile-remote-relay"
  ],
  "scripts": {
    "dev": "vite --port 5173",
    "dev:vite": "vite --port 5173",
    "dev:electron": "electron .",
    "build": "vite build && node scripts/build-electron.cjs",
    "build:dir": "vite build && node scripts/build-electron.cjs --dir",
    "release:prepare": "node scripts/run-release.cjs",
    "test": "vitest run",
    "test:gate": "npm run lint && git diff --check && npm test && npm run test:mobile-remote",
    "test:watch": "vitest",
    "test:mobile-remote": "npm run test -w @codebuddy/mobile-remote-protocol && npm run test -w @codebuddy/mobile-remote-crypto && npm run test -w @codebuddy/mobile-remote-relay && node --test --test-timeout=20000 electron/mobile-remote/tests/*.test.cjs",
    "mobile-remote:relay": "npm run start -w @codebuddy/mobile-remote-relay",
    "test:e2e:baseline": "node scripts/test/e2e-baseline.cjs",
    "test:e2e:launch": "vite build && node scripts/test/e2e-launch.cjs",
    "test:e2e:renderer": "vite build && node scripts/test/e2e-renderer.cjs",
    "test:e2e:unpackaged": "vite build && node scripts/test/e2e-launch.cjs && node scripts/test/e2e-renderer.cjs",
    "test:e2e": "npm run test:e2e:unpackaged",
    "test:packaged": "npm run build:dir && node scripts/test/e2e-packaged.cjs",
    "test:bundle-budget": "node scripts/test/bundle-budget.cjs",
    "test:perf:production": "npm run build:dir && node scripts/test/manual-perf-gui.cjs --packaged",
    "test:release": "npm run test:gate && npm run test:e2e && npm run test:bundle-budget && npm run test:packaged && npm run test:perf:production && npm run test:perf:memory",
    "prepublishOnly": "npm run test",
    "lint": "eslint electron src tests --ext .js,.jsx,.cjs",
    "lint:fix": "eslint electron src tests --ext .js,.jsx,.cjs --fix",
    "format": "prettier --write \"electron/**/*.{js,cjs}\" \"src/**/*.{js,jsx}\" \"tests/**/*.{js,jsx}\"",
    "test:bundle-budget:update": "node scripts/test/bundle-budget.cjs --update-baseline",
    "test:perf:memory": "node scripts/test/perf-memory.cjs",
    "test:perf:probe": "node scripts/test/perf-capability-probe.cjs"
  },
  "dependencies": {
    "@codebuddy/mobile-remote-crypto": "0.1.0",
    "@codebuddy/mobile-remote-protocol": "0.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "base64-js": "^1.5.1",
    "electron-store": "^8.2.0",
    "express": "^4.21.2",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.55.1",
    "node-fetch": "^2.7.0",
    "qrcode": "^1.5.4",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.38",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "vitest": "^3.2.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.codebuddy.gui",
    "productName": "CodeBuddy Desktop",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "CodeBuddy-GUI-Setup-${version}.${ext}"
    },
    "nsis": {
      "packElevateHelper": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeBuddy Desktop",
      "uninstallDisplayName": "CodeBuddy Desktop",
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "packages/mobile-remote-protocol/**/*",
      "packages/mobile-remote-crypto/**/*",
      "build/icon.png",
      "build/icon-mark.png",
      "build/icon.ico",
      "LICENSE",
      "package.json"
    ]
  }
}
